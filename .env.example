# No longer needed — Last.fm handles everything

# Last.fm (required for accurate top tracks/artists data):
# 1. Sign up at https://www.last.fm
# 2. Connect Spotify to Last.fm: Settings → Applications → "Connect Spotify Account"
# 3. Get a free API key: https://www.last.fm/api/account/create
# After setup, Last.fm automatically scrobbles your Spotify activity.
# Your top tracks/artists data updates ~daily.
LASTFM_API_KEY=
LASTFM_USERNAME=

# Wakatime API key (required for activity monitor)
# Get it at https://wakatime.com/api-key
WAKATIME_API_KEY=
